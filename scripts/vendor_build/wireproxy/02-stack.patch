+// saveUndo records the congestion state just before a fast-recovery loss
+// response, for undoRecovery.
+//
+// +checklocks:s.ep.mu
+func (s *sender) saveUndo() {
+	s.undoValid = true
+	s.undoCwnd = s.SndCwnd
+	s.undoSsthresh = s.Ssthresh
+	s.undoCubic = false
+	if c, ok := s.cc.(*cubicState); ok {
+		s.undoCubic = true
+		s.undoCubicT = c.T
+		s.undoCubicK = c.K
+		s.undoCubicWMax = c.WMax
+		s.undoCubicWLastMax = c.WLastMax
+		s.undoCubicEvents = c.numCongestionEvents
+	}
+}
+
+// undoRecovery reverts the congestion response of a recovery that the
+// RFC 3522 check has judged spurious (the response of RFC 4015; Linux does the
+// same in tcp_undo_cwnd_reduction with unmark_loss). The window and threshold
+// return to their values from before the response, the segments RACK marked
+// lost are unmarked, and RACK's reordering window is widened one step, as it
+// is for a DSACK, so that the same delay is tolerated the next time.
+//
+// +checklocks:s.ep.mu
+func (s *sender) undoRecovery() {
+	s.undoValid = false
+	outstanding := 0
+	for seg := s.writeList.Front(); seg != nil && seg.xmitCount != 0; seg = seg.Next() {
+		seg.lost = false
+		if !s.ep.scoreboard.IsSACKED(seg.sackBlock()) {
+			outstanding += s.pCount(seg, s.MaxPayloadSize)
+		}
+	}
+	s.Outstanding = outstanding
+	if s.undoSsthresh > s.Ssthresh {
+		s.Ssthresh = s.undoSsthresh
+	}
+	if s.undoCwnd > s.SndCwnd {
+		s.SndCwnd = s.undoCwnd
+	}
+	if c, ok := s.cc.(*cubicState); ok && s.undoCubic {
+		c.T = s.undoCubicT
+		c.K = s.undoCubicK
+		c.WMax = s.undoCubicWMax
+		c.WLastMax = s.undoCubicWLastMax
+		c.numCongestionEvents = s.undoCubicEvents
+	}
+	if s.FastRecovery.Active {
+		s.FastRecovery.Active = false
+		s.FastRecovery.MaxCwnd = 0
+		s.DupAckCount = 0
+	}
