+/* SPDX-License-Identifier: MIT
+ *
+ * Copyright (C) 2017-2025 WireGuard LLC. All Rights Reserved.
+ */
+
+package netstack
+
+import (
+	"syscall"
+	"time"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+	"gvisor.dev/gvisor/pkg/tcpip"
+)
+
+// On Windows the Go runtime's monotonic clock is the kernel's interrupt time,
+// which only advances at a timer interrupt: in steps of 0.5 to 1 ms while some
+// program has asked for a fine timer and of 15.6 ms otherwise. TCP's loss
+// detection (RACK), its round-trip samples and CUBIC's slow-start exit all
+// compare transmit and arrival times, so the stack is given a clock read from
+// the performance counter instead (steps well under a microsecond). Timers
+// still come from the time package.
+
+var (
+	kernel32                      = windows.NewLazySystemDLL("kernel32.dll")
+	procQueryPerformanceCounter   = kernel32.NewProc("QueryPerformanceCounter")
+	procQueryPerformanceFrequency = kernel32.NewProc("QueryPerformanceFrequency")
+)
+
+type performanceClock struct {
+	counter   uintptr
+	base      int64
+	frequency int64
+}
+
+func newStackClock() tcpip.Clock {
+	if procQueryPerformanceCounter.Find() != nil || procQueryPerformanceFrequency.Find() != nil {
+		return nil
+	}
+	c := &performanceClock{counter: procQueryPerformanceCounter.Addr()}
+	syscall.SyscallN(procQueryPerformanceFrequency.Addr(), uintptr(unsafe.Pointer(&c.frequency)))
+	syscall.SyscallN(c.counter, uintptr(unsafe.Pointer(&c.base)))
+	if c.frequency <= 0 {
+		return nil
+	}
+	return c
+}
+
+// Now implements tcpip.Clock.Now.
+func (*performanceClock) Now() time.Time { return time.Now() }
+
+// NowMonotonic implements tcpip.Clock.NowMonotonic.
+func (c *performanceClock) NowMonotonic() tcpip.MonotonicTime {
+	var now int64
+	syscall.SyscallN(c.counter, uintptr(unsafe.Pointer(&now)))
+	ticks := now - c.base
+	nanoseconds := (ticks/c.frequency)*int64(time.Second) + (ticks%c.frequency)*int64(time.Second)/c.frequency
+	var zero tcpip.MonotonicTime
+	return zero.Add(time.Duration(nanoseconds))
+}
+
+// AfterFunc implements tcpip.Clock.AfterFunc.
+func (*performanceClock) AfterFunc(d time.Duration, f func()) tcpip.Timer {
+	return tcpip.NewStdTimer(time.AfterFunc(d, f))
+}
