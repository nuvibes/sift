# Secrets
.env
.env.*
!.env.example
cookies/
*_cookies.txt
*.cookies

# Runtime state
/data/
/cache/
/media/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
# The client's gate tests live in a folder of this name; it is source, not a build's output.
!frontend/src/lib/build/
dist/
# electron-builder's output. Deliberately NOT `dist`, which is what it PACKS (see the
# `directories` block in desktop/electron-builder.yml).
release/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
coverage.xml
htmlcov/

# Node / frontend
#
# Kept here rather than in a second ignore file inside frontend/. The one the scaffolder writes
# un-ignores a dotenv that the rules at the top of this file deliberately ignore, and a nested file
# wins for its own directory, so the tree would have had a hole in it by default.
node_modules/
.svelte-kit/
*.tsbuildinfo
vite.config.ts.timestamp-*

# The built client. Generated by the frontend build into the Python package, where the server finds
# it. Never committed: it is output, and a stale copy of it committed here is one that ships.
src/sift/web/

# Generated by the icon build from the icon list. Derived, so it is never committed: a copy
# committed here is one that can disagree with the list it came from.
frontend/static/fonts/
frontend/src/lib/generated/

# The coverage report the client gate reads. Generated on every run of it and never committed:
# the numbers that matter are in scripts/client-coverage-baseline.json.
frontend/coverage/

# Playwright
frontend/test-results/
frontend/playwright-report/
# The folders the end-to-end run hands to the picker. Made and emptied by e2e/serve.sh.
frontend/e2e/.media/

# Tooling / OS
.semgrep_logs/
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Generated SBOM (CI attaches it to the run; not a source artifact)
sbom.cdx.json

# Playwright output (run from repo root or frontend)
test-results/

# The vendored Windows binaries. Fetched and SHA-256-verified by
# scripts/fetch_vendor.py from scripts/vendor_manifest.json, 266 MB of executables that do not
# belong in git. vendor/_cache is a real artefact worth backing up: upstream prunes old builds, and
# a verified copy here is what keeps a build working after the pinned URL is gone.
/vendor/
# The desktop shell's generated output. `build/` and `dist/` above already cover the bundle and the
# installer; these two are the coverage report and whatever electron-rebuild leaves beside the addon.
desktop/coverage/
desktop/native/drag/bin/

# An optional design gallery, not part of this tree, and where a signed build moves it aside.
/frontend/src/routes/design/
/frontend/.design-aside/
