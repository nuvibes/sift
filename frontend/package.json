{
	"name": "sift-frontend",
	"private": true,
	"type": "module",
	"license": "AGPL-3.0-or-later",
	"repository": "github:nuvibes/sift",
	"scripts": {
		"dev": "npm run fonts && vite dev",
		"build": "npm run fonts && vite build && node scripts/mark_build.js",
		"build:ifstale": "node scripts/build_if_stale.js",
		"preview": "vite preview",
		"prepare": "(svelte-kit sync || echo '') && npm run fonts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test:unit": "vitest run",
		"test:unit:coverage": "vitest run --coverage",
		"gate:client-coverage": "npm run test:unit:coverage && node scripts/check_client_coverage.js",
		"test:e2e": "playwright test",
		"visual": "playwright test --project visual",
		"fonts": "node scripts/prepare_fonts.js && node scripts/write_theme_boot.js",
		"gate:tokens": "node scripts/check_no_hex_literals.js",
		"gate:tokens-exist": "node scripts/check_tokens_exist.js",
		"gate:theme": "node scripts/check_dark_only.js",
		"gate:offline": "node scripts/check_no_external_refs.js",
		"gate:chrome": "node scripts/check_no_native_chrome.js",
		"gate:narration": "node scripts/check_no_narration.js",
		"gate:dead-css": "node scripts/check_no_dead_css.js",
		"gate:bits-first": "node scripts/check_bits_first.js",
		"gate:handrolled": "node scripts/check_handrolled.js",
		"gate:hover": "node scripts/check_hover_answers.js",
		"gate:one-field": "node scripts/check_one_field.js",
		"gate:shortcuts": "node scripts/check_shortcuts.js",
		"gate:one-scrollbar": "node scripts/check_one_scrollbar.js",
		"gate:capped-scroller": "node scripts/check_capped_scroller.js",
		"gate:styled": "node scripts/check_styled.js",
		"gate:handed-class": "node scripts/check_handed_class.js",
		"gate:css-comments": "node scripts/check_css_comments.js",
		"gate:anchored-globals": "node scripts/check_anchored_globals.js",
		"gate:effect-load-loop": "node scripts/check_effect_load_loop.js",
		"gate:one-facts": "node scripts/check_one_facts_definition.js",
		"gate:one-step": "node scripts/check_one_step.js",
		"gate:one-server-type": "node scripts/check_one_server_type.js",
		"gate:settings-followed": "node scripts/check_settings_followed.js",
		"gate:settings-row": "node scripts/check_settings_row.js",
		"gate:one-time-format": "node scripts/check_one_time_format.js",
		"gate:vocabulary": "node scripts/check_vocabulary.js",
		"gate:tooltip-name": "node scripts/check_tooltip_is_the_name.js",
		"gate:case": "node scripts/check_case_collisions.js",
		"gate:licenses": "node scripts/check_licenses.js",
		"e2e:server": "node e2e/serve.mjs",
		"gate:window-chrome": "node scripts/check_window_chrome_is_padding.js",
		"gate:design-entries": "node scripts/check_design_entries.js",
		"gate:design-fence": "node scripts/check_design_fence.js",
		"gate:dependencies": "node scripts/check_dependencies.js",
		"gate:code-shape": "node scripts/check_code_shape.js",
		"gate:structure": "node scripts/gates.js"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "22.20.4",
		"@vitest/coverage-v8": "4.1.11",
		"fontkit": "2.0.4",
		"jsdom": "29.1.1",
		"openapi-typescript": "7.13.0",
		"prettier": "3.9.9",
		"prettier-plugin-svelte": "4.1.1",
		"subset-font": "2.9.0",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"typescript": "5.9.3",
		"vite": "8.3.1",
		"vitest": "4.1.11"
	},
	"dependencies": {
		"@fontsource-variable/archivo": "5.3.0",
		"@fontsource-variable/dm-sans": "5.3.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@fontsource-variable/instrument-sans": "5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "5.3.0",
		"@fontsource-variable/manrope": "^5.3.0",
		"@fontsource-variable/public-sans": "^5.3.0",
		"@fontsource-variable/sora": "5.3.0",
		"@fontsource-variable/space-grotesk": "^5.3.0",
		"@internationalized/date": "3.12.4",
		"bits-ui": "2.19.3",
		"hls.js": "^1.7.3",
		"material-symbols": "0.47.5",
		"motion": "12.43.0"
	},
	"overrides": {
		"js-yaml": "4.3.2",
		"brace-expansion": "5.0.12",
		"cookie": "0.7.2",
		"nanoid": "^3.3.17"
	}
}
