---
// SPDX-License-Identifier: AGPL-3.0-or-later
// The home page's hero: the app's lockup as the title, the tagline, the page's `about` paragraph
// and Starlight's actions, over a photograph of the app. The lockup is the one the header draws (SiteTitle.astro). Starlight
// draws a hero picture as a 400 pixel square beside the words, which crops a screen to its middle,
// so the screen is drawn whole and full width under them instead. An action's link to a page of
// the site is written under the site's base, as astro.config.mjs writes every link in a page.
import { Image } from 'astro:assets';
import { LinkButton } from '@astrojs/starlight/components';

declare const __SIFT_LOCKUP__: string;
const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, image, actions = [] } = data.hero ?? {};
if (image && !('file' in image)) {
	throw new Error(`${data.title}: the hero takes one photograph, as image.file`);
}
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (link: string) => (link.startsWith('/') && !link.startsWith('//') ? base + link : link);
---

<div class="hero">
	<div class="copy">
		<h1 id="_top" data-page-title>
			<Fragment set:html={__SIFT_LOCKUP__} />
			<span class="sr-only" translate="no">{title}</span>
		</h1>
		{tagline && <div class="tagline" set:html={tagline} />}
		{data.about && <p class="about">{data.about}</p>}
	</div>
	{
		actions.length > 0 && (
			<div class="actions">
				{actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link, text, variant }) => (
					<LinkButton
						href={href(link)}
						{variant}
						icon={icon?.name}
						class:list={[className]}
						{...attrs}
					>
						{text}
						{icon?.html && <Fragment set:html={icon.html} />}
					</LinkButton>
				))}
			</div>
		)
	}
	{
		image && (
			<Image
				src={image.file}
				alt={image.alt}
				widths={[800, 1200, 1600]}
				sizes="(min-width: 72rem) 72rem, 100vw"
				loading="eager"
				class="screen"
			/>
		)
	}
</div>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
		padding-block: clamp(2rem, calc(1rem + 6vmin), 5rem) 1rem;
		text-align: center;
	}

	.copy {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}

	.copy > * {
		max-width: 50ch;
	}

	.copy > .about {
		max-width: 68ch;
		color: var(--sl-color-gray-2);
	}

	h1 {
		display: flex;
		justify-content: center;
		line-height: 1;
		color: var(--sl-color-white);
	}

	/* The lockup at a title's size: its letters take the ink and its grain the accent. */
	h1 :global(svg) {
		height: clamp(3.5rem, calc(2rem + 6vw), 6rem);
		width: auto;
	}

	.tagline {
		font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
		color: var(--sl-color-gray-2);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem 2rem;
	}

	/* The app's own frame: the large corner and the strong line it draws round a raised surface. */
	.screen {
		width: 100%;
		height: auto;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: var(--radius-lg);
	}
</style>
