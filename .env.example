# Settings for the Sift server, each prefixed SIFT_ and each optional: a line left commented out
# keeps its default. Sift reads them from the environment and from a file named .env in the folder
# its server starts in; the environment wins. Copy this file to .env to use it.
#
# The desktop application sets the folders, the address, the tool paths and the log level for the
# server it starts, so in an installed copy those lines here change nothing. Site logins are
# encrypted with a key derived from your own password, so there is no key to set here.

# --- Folders ---------------------------------------------------------------------------------

# The library's database, the only folder to back up. Default on Windows: %LOCALAPPDATA%\Sift\data.
#SIFT_DATA_DIR=/data

# Thumbnails, previews, transcoded segments; safe to delete. On Windows: %LOCALAPPDATA%\Sift\cache.
#SIFT_CACHE_DIR=/cache

# Where transcoded segments are kept while they are watched. Default: "transcode" in the cache.
#SIFT_TRANSCODE_CACHE_DIR=/cache/transcode

# The most the transcode folder holds before its oldest segments are deleted, in bytes (5 GiB).
#SIFT_TRANSCODE_CACHE_MAX_BYTES=5368709120

# Where files that fail the safety check on the way in are set aside. Default: "quarantine" in data.
#SIFT_QUARANTINE_DIR=/data/quarantine

# --- Behaviour -------------------------------------------------------------------------------

# Force the login cookie's Secure mark (HTTPS only). Unset, it is Secure when a request is HTTPS.
#SIFT_COOKIE_SECURE=true

# Serve the interactive API documentation at /docs; it lists every endpoint to whoever opens it.
#SIFT_ENABLE_DOCS=false

# How many jobs run at once, 1 to 64. Unset, Sift picks a number from the hardware it finds.
#SIFT_WORKER_CONCURRENCY=4

# The graphics acceleration to expect: auto, cuda (NVIDIA) or rocm (AMD); a missing card is said.
#SIFT_GPU=auto

# DEBUG, INFO, WARNING, ERROR or CRITICAL. DEBUG adds the full detail of every error.
#SIFT_LOG_LEVEL=INFO

# Show file paths and usernames in the lines written while Sift starts; the Logs page decides after.
#SIFT_LOG_UNREDACTED=false

# The size of sift.log in the data folder before it rolls over, in bytes; 0 writes no file.
#SIFT_LOG_MAX_BYTES=10485760

# How many rolled-over log files are kept beside it.
#SIFT_LOG_BACKUPS=5

# --- Tools -----------------------------------------------------------------------------------

# ffmpeg and ffprobe: a full path, or a name found on PATH.
#SIFT_FFMPEG_PATH=ffmpeg
#SIFT_FFPROBE_PATH=ffprobe

# webpinfo and anim_dump, which read animated WebP files (ffmpeg cannot read them).
#SIFT_WEBPINFO_PATH=webpinfo
#SIFT_ANIM_DUMP_PATH=anim_dump

# --- Network ---------------------------------------------------------------------------------

# The address to listen on. Default: 0.0.0.0 (every address) on Linux, 127.0.0.1 on Windows.
#SIFT_HOST=0.0.0.0

# The port to listen on.
#SIFT_PORT=5171

# Other origins allowed to call the API from a browser, comma-separated; never "*". Default: none.
#SIFT_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Measuring -------------------------------------------------------------------------------

# Milliseconds since the last key press, read in place of the computer's own reading.
#SIFT_ATTENTION_FAKE_INPUT_MS=600000

# The same number read from a file at every reading, so it can change while Sift runs.
#SIFT_ATTENTION_FAKE_INPUT_FILE=idle-ms.txt

# --- Set by the desktop application for the server it starts; never set by hand -------------

# Where the release check reads from. Unset, Sift never checks for a newer release.
#SIFT_RELEASE_FEED_URL=

# Shut down cleanly when the process that started Sift closes its stdin.
#SIFT_STOP_ON_STDIN_EOF=false

# The address and this launch's secret for asking the desktop application to act on this computer.
#SIFT_SHELL_URL=
#SIFT_SHELL_TOKEN=
